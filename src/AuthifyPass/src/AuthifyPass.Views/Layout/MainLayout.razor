@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<MainLayoutResource> L
@inject IJSRuntime JS

<header class="navbar is-light has-shadow" >
    <div class="navbar-brand">
        <a href="https://sergiortizgomez.com/#contact" class="navbar-item" target="_blank">
            <i class="fa-solid fa-headset"></i>
        </a>
        <a class="navbar-item" href="">
            <img src="_content/AuthifyPass.Views/img/Logo512.png" alt="AuthifyPass" style="height: 32px; width: 32px; margin-right: 8px;" />
            <strong>AuthifyPass</strong>
        </a>
    </div>

    <div id="navbarMenu" class="navbar-menu">
        <div class="navbar-start">
            <a href="about-us" class="navbar-item">
                <span class="icon"><i class="fas fa-info-circle"></i></span>
                <span>@L["AboutUs"]</span>
            </a>  
        </div>
        <div class="navbar-end">
            <a href="register" target="_top" class="navbar-item">
                <span class="icon"><i class="fas fa-user-plus"></i></span>
                <span>@L["RegisterAsDeveloper"]</span>
            </a>
            <a href="https://github.com/drualcman/AuthifyPass" target="_blank" class="navbar-item">
                <span class="icon"><i class="fab fa-github"></i></span>
                <span>@L["ViewOnGitHub"]</span>
            </a>
        </div>
    </div>
</header>

@if (updateAvailable)
{
    <div class="notification is-warning is-light"
         style="position:fixed;top:0;left:0;right:0;z-index:1000;margin:0;border-radius:0;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0.5rem 1rem;">
        <span><i class="fas fa-download"></i> @L["UpdateAvailable"]</span>
        <button class="button is-small is-warning" @onclick="RestartAsync">@L["RestartNow"]</button>
    </div>
}

<main class="container">
    <article class="content">
        @Body
    </article>
    <footer class="content has-text-centered app-version">
        @AppVersionText
    </footer>
</main>

@code {
    private string AppVersionText { get; } = "AuthifyPass v" + AppInfo.Version;

    private DotNetObjectReference<MainLayout>? selfReference;
    private bool updateAvailable;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initServiceWorker", selfReference);
        }

        await Task.CompletedTask;
    }

    [JSInvokable]
    public void NotifyUpdateAvailable()
    {
        updateAvailable = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task RestartAsync()
    {
        await JS.InvokeVoidAsync("restartServiceWorker");
    }

    public void Dispose()
    {
        selfReference?.Dispose();
    }
}
