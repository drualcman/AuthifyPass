@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject IStringLocalizer<AboutUsResource> L

<div class="field has-addons">
    <div class="control is-expanded">
        <input placeholder="@ViewModel.SearchPlaceholderText" class="input is-rounded"
               @bind-Value=ViewModel.SearchText @bind-Value:event="oninput" />
    </div>
    <div class="control">
        <a href="add" class="button is-link">
            <span class="icon"><i class="fa-solid fa-file-circle-plus"></i></span>
        </a>
    </div>
</div>

@if (ViewModel.HasCodes)
{
    <div class="timer-dock">
        <CountDownComponent TimeToCount=30 OnReset=ViewModel.RefreshCodes />
    </div>
}

<div class="codes-list">
    @if (ViewModel.HasCodes)
    {
        foreach (var item in ViewModel.TwoFactorCodes)
        {
            <div class="code-card box">
                <button class="action-button is-info" title="@ViewModel.ShareTitleText" @onclick="() => ViewModel.OpenShareModal(item)">
                    <span class="icon"><i class="fa-solid fa-share-nodes"></i></span>
                </button>
                <div class="code-display" @onclick="() => ViewModel.CopyToClipboard(item.CurrentCode)">
                    <div class="description-container">
                        <p class="description is-size-6">@item.Description</p>
                        <p class="name is-size-7">@item.Name</p>
                    </div>
                    <div class="code-container">
                        <p class="code is-size-2 has-text-weight-bold">@item.CurrentCode</p>
                    </div>
                </div>
                <button class="button is-danger action-button" title="@ViewModel.DeleteButtonContent" @onclick="() => ViewModel.OpenDeleteModal(item)">
                    <span class="icon"><i class="fa-solid fa-trash-can"></i></span>
                </button>
            </div>
        }
    }
    else
    {
        <p>@(new MarkupString(ViewModel.NoCodesContent))</p>
    }
</div>

<ModalComponent @bind-IsVisible="ViewModel.IsModalVisible"
                OnClose="ViewModel.CloseModal">
    <Title>
        @(new MarkupString(ViewModel.ModalTitleContent))
    </Title>
    <BodyContent>
        @(new MarkupString(ViewModel.ModalBodyContent))
    </BodyContent>
    <FooterContent>
        <button class="button is-danger @(ViewModel.IsDeleting ? "is-loading":"")" @onclick="ViewModel.DeleteSelectedCode">@(new MarkupString(ViewModel.DeleteButtonContent))</button>
        <button class="button" @onclick="ViewModel.CloseModal">@(new MarkupString(ViewModel.CancelButtonContent))</button>
    </FooterContent>
</ModalComponent>


<ModalComponent @bind-IsVisible="ViewModel.IsShareVisible"
                OnClose="ViewModel.CloseShareModal">
    <Title>
        @ViewModel.ShareTitleText
    </Title>
    <BodyContent>
        <div class="content has-text-centered">
            @if (ViewModel.HasShareQr)
            {
                <div class="share-qr">@((MarkupString)ViewModel.ShareQrSvg)</div>
            }
            <p>@ViewModel.ShareHintText</p>
        </div>
    </BodyContent>
    <FooterContent>
        @if (ViewModel.IsConfirmingSecretCopy)
        {
            <span class="has-text-danger"><i class="fas fa-triangle-exclamation"></i> @ViewModel.ConfirmSecretText</span>
            <button class="button is-danger" @onclick="ViewModel.ConfirmCopySecret">@ViewModel.ConfirmYesText</button>
            <button class="button" @onclick="ViewModel.CancelCopySecret">@ViewModel.ConfirmNoText</button>
        }
        else
        {
            <button class="button is-link" @onclick="ViewModel.CopyOtpAuthUri">@ViewModel.CopyLinkButtonText</button>
            <button class="button is-info is-light" @onclick="ViewModel.RequestCopySecret">@ViewModel.CopySecretButtonText</button>
            <button class="button" @onclick="ViewModel.CloseShareModal">@ViewModel.ShareCloseButtonText</button>
        }
    </FooterContent>
</ModalComponent>

<ToastMessageComponent />