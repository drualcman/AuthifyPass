<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="manifest.webmanifest" rel="manifest" />
    <meta name="theme-color" content="#00796b" />
    <link rel="icon" href="_content/AuthifyPass.Views/img/favicon.ico" type="image/x-icon">
    <link rel="icon" href="_content/AuthifyPass.Views/img/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" sizes="512x512" href="_content/AuthifyPass.Views/img/Logo512.png" />
    <link rel="stylesheet" href="_content/AuthifyPass.Views/lib/bulma/bulma.min.css" />
    <link rel="stylesheet" href="_content/AuthifyPass.Views/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="@Assets["_content/AuthifyPass.Views/css/app.css"]" />
    <link rel="stylesheet" href="@Assets["AuthifyPass.API.styles.css"]" />
    <title>AuthifyPass</title>
    <script>
        window.blazorCulture = {
            get: () => window.localStorage['BlazorCulture'],
            set: (value) => window.localStorage['BlazorCulture'] = value
        };
        if (!window.blazorCulture.get()) {
            window.blazorCulture.set(navigator.language || navigator.userLanguage);
        }
    </script>
    <script>
        window.getCacheVersion = function () {
            return new Promise(function (resolve) {
                var controller = navigator.serviceWorker && navigator.serviceWorker.controller;
                if (!controller) { resolve(''); return; }
                function onMessage(e) {
                    if (e.data && e.data.type === 'version') {
                        navigator.serviceWorker.removeEventListener('message', onMessage);
                        clearTimeout(timer);
                        resolve(e.data.version);
                    }
                }
                var timer = setTimeout(function () {
                    navigator.serviceWorker.removeEventListener('message', onMessage);
                    resolve('');
                }, 2000);
                navigator.serviceWorker.addEventListener('message', onMessage);
                controller.postMessage({ type: 'getVersion' });
            });
        };
    </script>
    <script>
        // Captures boot/runtime failures (module/resource load errors, unhandled rejections) and shows
        // them inside the error banner, so the real reason is readable on-device without devtools.
        (function () {
            var box = null;
            var detail = null;

            function ensure() {
                if (!box) {
                    box = document.getElementById('blazor-error-ui');
                    detail = document.getElementById('blazor-error-detail');
                }
                return box;
            }

            function show(text) {
                if (!ensure()) { return; }
                if (detail) {
                    detail.textContent = (detail.textContent ? detail.textContent + '\n' : '') + text;
                }
                box.style.display = 'block';
            }

            function describeResource(e) {
                var t = e && e.target;
                if (t && (t.tagName === 'SCRIPT' || t.tagName === 'LINK')) {
                    return t.tagName + ' ' + (t.src || t.href || '(no url)');
                }
                return '';
            }

            window.__authifyLogError = show;

            window.addEventListener('error', function (e) {
                var res = describeResource(e);
                var msg = res
                    ? ('Failed to load ' + res)
                    : (e && e.message ? ('Error: ' + e.message + (e.filename ? (' at ' + e.filename + ':' + e.lineno) : '')) : 'Unknown error');
                show(msg);
            }, true);

            window.addEventListener('unhandledrejection', function (e) {
                var r = e && e.reason;
                var msg = 'Rejection: ' + ((r && (r.message || r.stack)) || (typeof r === 'string' ? r : '(see console)'));
                show(msg);
            });
        })();
    </script>
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <div id="blazor-error-ui" data-nosnippet class="blazor-error-boundary" style="display:none;background:#b71c1c;color:#ffffff">
        <div class="blazor-error-inner">
            <span class="icon"><i class="fas fa-triangle-exclamation"></i></span>
            <div class="message">
                Something didn't load. Check your connection and try again.
                <pre id="blazor-error-detail" class="blazor-error-detail" style="color:#ffffff;background:rgba(0,0,0,.35)"></pre>
            </div>
            <a href="" class="reload button is-small is-warning">Reload</a>
            <span class="dismiss" title="Dismiss">🗙</span>
        </div>
    </div>
    <Routes />
    <script src="_content/AuthifyPass.Views/js/boot-diagnostics.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Registered/called from MainLayout (interactive WASM) so the app can show an explicit
        // "update available" banner instead of reloading silently.
        window.initServiceWorker = function (dotNetRef) {
            if (!('serviceWorker' in navigator)) { return; }
            navigator.serviceWorker.register('service-worker.js', { updateViaCache: 'none', scope: '/' })
                .then(function (registration) {
                    function hasController() { return !!navigator.serviceWorker.controller; }

                    function announceWaiting() {
                        if (registration.waiting && hasController()) {
                            dotNetRef.invokeMethodAsync('NotifyUpdateAvailable');
                        }
                    }

                    announceWaiting();

                    registration.addEventListener('updatefound', function () {
                        var installing = registration.installing;
                        if (!installing) { return; }
                        installing.addEventListener('statechange', function () {
                            if (installing.state === 'installed' && hasController()) {
                                dotNetRef.invokeMethodAsync('NotifyUpdateAvailable');
                            }
                        });
                    });

                    // Re-check the server for a new build periodically.
                    setInterval(function () { registration.update().catch(function () { }); }, 60000);
                })
                .catch(function () { });
        };

        // Only called when the user taps "Restart": skip the waiting phase and reload onto the new build.
        window.restartServiceWorker = function () {
            navigator.serviceWorker.getRegistration().then(function (registration) {
                if (registration && registration.waiting) {
                    navigator.serviceWorker.addEventListener('controllerchange', function () {
                        window.location.reload();
                    }, { once: true });
                    registration.waiting.postMessage('skipWaiting');
                }
                else {
                    window.location.reload();
                }
            });
        };
    </script>
</body>

</html>
